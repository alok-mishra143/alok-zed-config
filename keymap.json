// Zed keymap — alok-zed-config
//
// Layered on top of the "VSCode" base keymap configured in settings.json,
// so every VS Code shortcut you already know keeps working.
//
// Docs: https://zed.dev/docs/key-bindings
// Edit this file in Zed with `cmd-k cmd-s`, or run
// "zed: open default keymap" from the command palette to see the defaults.
[
  // ---------------------------------------------------------------- Workspace
  {
    "context": "Workspace",
    "bindings": {
      // Ctrl-based panel shortcuts (Windows-style, matches the ctrl-* layout).
      "ctrl-b": "workspace::ToggleRightDock",
      "ctrl-p": "project_panel::ToggleFocus",
      "ctrl-`": "terminal_panel::Toggle",

      // Windows-style search and tab shortcuts.
      "ctrl-shift-f": "pane::DeploySearch",
      "ctrl-shift-h": ["pane::DeploySearch", { "replace_enabled": true }],
      "ctrl-shift-t": "pane::ReopenClosedItem",

      // AI and editor toggles.
      "ctrl-alt-p": "workspace::ToggleEditPrediction",

      // Tap shift twice to open the file finder (JetBrains-style).
      "shift shift": "file_finder::Toggle"
    },
    "unbind": {
      // The ctrl-* bindings above replace these dock toggles, so free the
      // macOS defaults to avoid accidental dock changes.
      "cmd-r": "workspace::ToggleRightDock",
      "cmd-j": "workspace::ToggleBottomDock",
      "cmd-shift-e": "project_panel::ToggleFocus"
    }
  },

  // ------------------------------------------------------------------- Editor
  {
    "context": "Editor",
    "bindings": {
      "ctrl-o": "editor::MoveLeft",
      "ctrl-alt-i": "editor::ToggleInlayHints",
      "ctrl-alt-g": "editor::ToggleGitBlameInline"
    },
    "unbind": {
      // Free the Emacs cursor keys so the ctrl-* workspace shortcuts below
      // also work while the editor has focus.
      "ctrl-b": "editor::MoveLeft",
      "ctrl-p": "editor::MoveUp",
      "ctrl-shift-f": "editor::SelectRight"
    }
  },

  // ------------------------------------------------------------------- Search
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "alt-f": "search::FocusSearch"
    },
    "unbind": {
      // Don't re-deploy the search bar while typing in it.
      "cmd-shift-f": "search::FocusSearch"
    }
  }
]
